{
  "name": "create-tester",
  "version": "0.9.2",
  "description": "tester 一体化:脚手架(npm create tester)+ 引擎(CLI/API/MCP 工具服务器),面向测试工程师的 AI 驱动页面测试",
  "keywords": [
    "testing",
    "test-automation",
    "playwright",
    "e2e",
    "ai-driven",
    "mcp",
    "cli",
    "scaffold"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.6"
  },
  "bin": {
    "create-tester": "dist/bin/create-tester.js",
    "tester": "dist/bin/tester.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist/"
  ],
  "workspaces": [
    "core"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Cifferni/create-tester.git"
  },
  "homepage": "https://github.com/Cifferni/create-tester",
  "bugs": {
    "url": "https://github.com/Cifferni/create-tester/issues"
  },
  "scripts": {
    "start": "tsx bin/tester.ts",
    "typecheck": "tsc --noEmit && npm --workspace core run typecheck",
    "build": "node scripts/build.cjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@create-tester/core": "^0.9.2",
    "commander": "^12.1.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/prompts": "^2.4.9",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
