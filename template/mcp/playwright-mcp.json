{
  "browser": {
    "browserName": "chromium",
    "isolated": true
  },
  "capabilities": [
    "core",
    "network"
  ],
  "testIdAttribute": "data-testid",
  "snapshot": {
    "mode": "full",
    "boxes": false
  },
  "network": {
    "allowedOrigins": [
      "*"
    ]
  },
  "timeouts": {
    "action": 5000,
    "navigation": 30000
  }
}
